# =====================================================================
# EyeKB house style v1.0  (ARCH-GOV t_9b244bd7, 2026-09-30)
# ---------------------------------------------------------------------
# Usage (either of the two):
#   1) Python:  import matplotlib.pyplot as plt
#               plt.style.use("<repo>/scripts/eyekb_house.mplstyle")
#   2) CLI:  run mplrc before the matplotlib script (or pass this file's path to style.use)
# Conventions (figure acceptance line):
#   - on-screen figures must savefig at >=150 dpi (this theme exports at 300 dpi; when the
#     renderer downsamples the on-screen png it must not go below 150 dpi);
#   - every results figure's annotation block must contain two lines: (1) sample size / unit
#     count (2) data scope (dataset accession / library version / service version); missing
#     either one bars external release;
#   - Chinese annotations depend on Noto Sans CJK; machines without the font fall back to
#     DejaVu (CJK renders as boxes) -- before publishing, re-render on a font-equipped
#     machine to confirm;
#   - palette avoids matplotlib's high-saturation defaults; use the low-saturation academic
#     eight-color sequence;
#     semantic convention: color 1 = primary/control, color 2 = disease/treatment,
#     color 3 = lineage or secondary group, color 4 = warning flag,
#     trailing gray = background/not significant.
# Authoritative location: this file (repo scripts/); production-disk plans and WIKI only
#   reference the path, never copy content (any color/font change goes in this file).
# =====================================================================

# ---- Resolution & export ----
figure.dpi: 150
savefig.dpi: 300
savefig.bbox: tight
savefig.pad_inches: 0.06
figure.facecolor: white
axes.facecolor: white
savefig.facecolor: white

# ---- Fonts ----
text.usetex: False
font.family: sans-serif
font.sans-serif: Noto Sans CJK SC, Noto Sans CJK JP, Noto Sans CJK TC, DejaVu Sans, Arial
axes.unicode_minus: False

font.size: 9.0
axes.titlesize: 11.0
axes.titleweight: bold
axes.labelsize: 9.5
xtick.labelsize: 8.0
ytick.labelsize: 8.0
legend.fontsize: 8.0
figure.titlesize: 12.5
figure.titleweight: bold

# ---- Color cycle (low-saturation eight colors) ----
axes.prop_cycle: cycler('color', ['2E5E7E', 'C77B3F', '4F7942', '9E3B3B', '5B5F97', '4FA3A5', '7A6A53', '8C8C8C'])

# ---- Axes & grid ----
axes.spines.top: False
axes.spines.right: False
axes.linewidth: 0.8
axes.grid: True
axes.axisbelow: True
grid.color: D9D9D9
grid.linewidth: 0.6
grid.alpha: 0.7

# ---- Ticks ----
xtick.direction: out
ytick.direction: out
xtick.major.size: 3.0
ytick.major.size: 3.0
xtick.major.width: 0.8
ytick.major.width: 0.8

# ---- Legend / line / marker ----
legend.frameon: False
legend.loc: best
lines.linewidth: 1.4
lines.markersize: 4.5
patch.linewidth: 0.6
patch.force_edgecolor: True

# ---- Patch edge color ----
patch.edgecolor: 555555
