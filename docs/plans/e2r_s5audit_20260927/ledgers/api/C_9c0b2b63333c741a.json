llName":"Kanmogne GD","lastName":"Kanmogne","firstName":"Georgette D","initials":"GD"},{"fullName":"Kumar M","lastName":"Kumar","firstName":"Mahendra","initials":"M"},{"fullName":"Letendre S","lastName":"Letendre","firstName":"Scott","initials":"S"},{"fullName":"Marcotte TD","lastName":"Marcotte","firstName":"Thomas D","initials":"TD","authorId":{"type":"ORCID","value":"0000-0002-3039-6400"}},{"fullName":"Nath A","lastName":"Nath","firstName":"Avindra","initials":"A"},{"fullName":"Pardo CA","lastName":"Pardo","firstName":"Carlos A","initials":"CA"},{"fullName":"Paul RH","lastName":"Paul","firstName":"Robert H","initials":"RH"},{"fullName":"Pulliam L","lastName":"Pulliam","firstName":"Lynn","initials":"L"},{"fullName":"Robertson K","lastName":"Robertson","firstName":"Kevin","initials":"K"},{"fullName":"Royal W 3rd","lastName":"Royal","firstName":"Walter","initials":"W"},{"fullName":"Sacktor N","lastName":"Sacktor","firstName":"Ned","initials":"N"},{"fullName":"Sithinamsuwan P","lastName":"Sithinamsuwan","firstName":"Pasiri","initials":"P"},{"fullName":"Smith DM","lastName":"Smith","firstName":"Davey M","initials":"DM","authorId":{"type":"ORCID","value":"0000-0003-3603-1733"}},{"fullName":"Valcour V","lastName":"Valcour","firstName":"Victor","initials":"V"},{"fullName":"Wigdahl B","lastName":"Wigdahl","firstName":"Brian","initials":"B"},{"fullName":"Wood C","lastName":"Wood","firstName":"Charles","initials":"C","authorId":{"type":"ORCID","value":"0000-0002-4256-1530"}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0002-3039-6400"},{"type":"ORCID","value":"0000-0002-4256-1530"},{"type":"ORCID","value":"0000-0003-0622-1392"},{"type":"ORCID","value":"0000-0003-3603-1733"},{"type":"ORCID","value":"0000-0003-4931-752X"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"issue":"1","volume":"19","journalIssueId":2008873,"dateOfPublication":"2013 Feb","monthOfPublication":2,"yearOfPublication":2013,"journal":{"medlineAbbreviation":"J Neurovirol","title":"Journal of neurovirology","essn":"1538-2443","issn":"1355-0284","isoabbreviation":"J Neurovirol","nlmid":"9508123"},"printPublicationDate":"2013-02-01"},"pubYear":"2013","pageInfo":"1-9","abstractText":"In May 2012, the Division of AIDS Research at the National Institute of Mental Health (NIMH) organized the \"Global NeuroAIDS Roundtable\" in conjunction with the 11th International Symposium on Neurovirology and the 2012 Conference on HIV in the Nervous System. The meeting was held in New York, NY, USA and brought together NIMH-funded investigators who are currently working on projects related to the neurological complications of AIDS (NeuroAIDS) in Africa, Asia, Eastern Europe, and Latin America in order to provide an opportunity to share their recent findings and discuss the challenges encountered within each country. The major goals of the roundtable were to evaluate HIV-associated neurocognitive impairment and determine if it may be directly attributable to distinct HIV subtypes or clades and to discuss the future priorities for global NeuroAIDS research. At the \"Global NeuroAIDS Roundtable\", presentations of preliminary research indicated that HIV-associated neurocognitive impairment is prevalent in all countries examined regardless of which HIV clade is present in the region. The only clear-cut difference between HIV-1 clades was in relation to subtypes A and D in Uganda. However, a key point that emerged from the discussions was that there is an urgent need to standardize neurocognitive assessment methodologies across the globe before definitive conclusions can be drawn regarding the relationship between HIV clade diversity and neuropathogenesis. Future research directions were also discussed at the roundtable with particular emphasis on the potential of viral and host factor molecular interactions to impact the pathophysiology of HIV-associated neurocognitive disorders (HAND) from a global perspective.","affiliation":"Division of AIDS Research, National Institute of Mental Health, National Institutes of Health, Bethesda, MD, USA, CONTACT_EMAIL","publicationStatus":"ppublish","language":"eng","pubModel":"Print-Electronic","pubTypeList":{"pubType":["Conference Proceedings","abstract","Research Support, N.I.H., Extramural"]},"grantsList":{"grant":[{"agency":"NIMH NIH HHS","acronym":"MH","grantId":"MH083573","orderIn":0},{"agency":"NINDS NIH HHS","acronym":"NS","grantId":"NS055628","orderIn":0},{"agency":"NIMH NIH HHS","acronym":"MH","grantId":"MH076651","orderIn":0},{"agency":"NIMH NIH HHS","acronym":"MH","grantId":"MH083489","orderIn":0},{"agency":"NIMH NIH HHS","acronym":"MH","grantId":"U01 MH083506","orderIn":0},{"agency":"NIMH NIH HHS","acronym":"MH","grantId":"MH073433","orderIn":0},{"agency":"NIMH NIH HHS","acronym":"MH","grantId":"MH094160","orderIn":0},{"agency":"NIMH NIH HHS","acronym":"MH","grantId":"R01 MH086356","orderIn":0},{"agency":"NIMH NIH HHS","acronym":"MH","grantId":"R01 MH094160","orderIn":0},{"agency":"NIMH NIH HHS","acronym":"MH","grantId":"U24 MH100928","orderIn":0},{"agency":"NIMH NIH HHS","acronym":"MH","grantId":"MH086356","orderIn":0},{"agency":"NIMH NIH HHS","acronym":"MH","grantId":"MH085604","orderIn":0},{"agency":"NIMH NIH HHS","acronym":"MH","grantId":"MH078748","orderIn":0},{"agency":"NIMH NIH HHS","acronym":"MH","grantId":"MH083465","orderIn":0},{"agency":"NIMH NIH HHS","acronym":"MH","grantId":"MH092225","orderIn":0},{"agency":"NIMH NIH HHS","acronym":"MH","grantId":"MH080611","orderIn":0},{"agency":"NIMH NIH HHS","acronym":"MH","grantId":"MH094159","orderIn":0},{"agency":"NCI NIH HHS","acronym":"CA","grantId":"R01 CA075903","orderIn":0},{"agency":"NIDA NIH HHS","acronym":"DA","grantId":"R01 DA019807","orderIn":0},{"agency":"NIMH NIH HHS","acronym":"MH","grantId":"MH077487","orderIn":0},{"agency":"NIMH NIH HHS","acronym":"MH","grantId":"MH080612","orderIn":0},{"agency":"NINDS NIH HHS","acronym":"NS","grantId":"NS055653","orderIn":0},{"agency":"NINDS NIH 