{"version":"6.9","hitCount":1,"request":{"queryString":"TITLE:\"Protocol for retinal stress culture and single-cell analysis.\"","resultType":"core","cursorMark":"*","pageSize":50,"sort":"","synonym":false},"resultList":{"result":[{"id":"41389328","source":"MED","pmid":"41389328","pmcid":"PMC12765171","fullTextIdList":{"fullTextId":["PMC12765171"]},"doi":"10.1016/j.xpro.2025.104271","title":"Protocol for retinal stress culture and single-cell analysis.","authorString":"Norrie JL, Ramirez C, Dyer MA.","authorList":{"author":[{"fullName":"Norrie JL","lastName":"Norrie","firstName":"Jackie L","initials":"JL","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Developmental Neurobiology, St. Jude Children's Research Hospital, Memphis, TN 38105, USA. Electronic address: CONTACT_EMAIL."}]}},{"fullName":"Ramirez C","lastName":"Ramirez","firstName":"Cody","initials":"C","authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Developmental Neurobiology, St. Jude Children's Research Hospital, Memphis, TN 38105, USA."}]}},{"fullName":"Dyer MA","lastName":"Dyer","firstName":"Michael A","initials":"MA","authorId":{"type":"ORCID","value":"0000-0003-4027-4850"},"authorAffiliationDetailsList":{"authorAffiliation":[{"affiliation":"Department of Developmental Neurobiology, St. Jude Children's Research Hospital, Memphis, TN 38105, USA. Electronic address: CONTACT_EMAIL."}]}}]},"authorIdList":{"authorId":[{"type":"ORCID","value":"0000-0003-4027-4850"}]},"dataLinksTagsList":{"dataLinkstag":["supporting_data"]},"journalInfo":{"issue":"1","volume":"7","journalIssueId":4138581,"dateOfPublication":"2026 Mar","monthOfPublication":3,"yearOfPublication":2026,"journal":{"medlineAbbreviation":"STAR Protoc","title":"STAR protocols","essn":"2666-1667","issn":"2666-1667","isoabbreviation":"STAR Protoc","nlmid":"101769501"},"printPublicationDate":"2026-03-01"},"pubYear":"2026","pageInfo":"104271","abstractText":"The retina is a dynamic neural