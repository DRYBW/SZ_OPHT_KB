liationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Microbiology and Immunology, Pennsylvania State University College of Medicine, Hershey, PA, USA."}]}}, {"fullName": "Stewart JP", "lastName": "Stewart", "firstName": "James P", "initials": "JP", "authorId": {"type": "ORCID", "value": "0000-0002-8928-2037"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Infection Biology, University of Liverpool, Liverpool, UK."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-7289-3459"}, {"type": "ORCID", "value": "0000-0002-0090-5710"}, {"type": "ORCID", "value": "0000-0002-5405-6988"}, {"type": "ORCID", "value": "0000-0002-8928-2037"}, {"type": "ORCID", "value": "0000-0003-3203-9463"}, {"type": "ORCID", "value": "0000-0003-3409-399X"}]}, "dataLinksTagsList": {"dataLinkstag": ["supporting_data", "related_data"]}, "journalInfo": {"issue": "6", "volume": "95", "journalIssueId": 2287960, "dateOfPublication": "2015 Jun", "monthOfPublication": 6, "yearOfPublication": 2015, "journal": {"medlineAbbreviation": "Lab Invest", "title": "Laboratory investigation; a journal of technical methods and pathology", "essn": "1530-0307", "issn": "0023-6837", "isoabbreviation": "Lab Invest", "nlmid": "0376617"}, "printPublicationDate": "2015-06-01"}, "pubYear": "2015", "pageInfo": "610-624", "abstractText": "Murine \u03b3-herpesvirus 68 (MHV-68) infection of Mus musculus-derived strains of mice is an established model of \u03b3-herpesvirus infection. We have previously developed an alternative system using a natural host, the wood mouse (Apodemus sylvaticus), and shown that the MHV-68 M3 chemokine-binding protein contributes significantly to MHV-68 pathogenesis. Here we demonstrate in A. sylvaticus using high-density micro-arrays that M3 influences the expression of genes involved in the host response including Scgb1a1 and Bpifa1 that encode potential innate defense proteins secreted into the respiratory tract. Further analysis of MHV-68-infected animals showed that the levels of both protein and RNA for SCGB1A1 and BPIFA1 were decreased at day 7 post infection (p.i.) but increased at day 14 p.i. as compared with M3-deficient and mock-infected animals. The modulation of expression was most pronounced in bronchioles but was also present in the bronchi and trachea. Double staining using RNA in situ hybridization and immunohistology demonstrated that much of the BPIFA1 expression occurs in club cells along with SCGB1A1 and that BPIFA1 is stored within granules in these cells. The increase in SCGB1A1 and BPIFA1 expression at day 14 p.i. was associated with the differentiation of club cells into mucus-secreting cells. Our data highlight the role of club cells and the potential of SCGB1A1 and BPIFA1 as innate defense mediators during respiratory virus infection.", "affiliation": "1] Department of Infection Biology, University of Liverpool, Liverpool, UK [2] Department of Veterinary Pathology, School of Veterinary Science, University of Liverpool, Liverpool, UK.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "research-article", "Journal Article", "Research Support, N.I.H., Extramural"]}, "grantsList": {"grant": [{"agency": "Biotechnology and Biological Sciences Research Council", "grantId": "BB/K009737/1", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R01 CA090208", "orderIn": 0}, {"agency": "Biotechnology and Biological Sciences Research Council", "grantId": "BB/K009664/1", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "CA090208", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Respiratory Mucosa", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "CY", "qualifierName": "cytology"}, {"majorTopic_YN": "N", "abbreviation": "ME", "qualifierName": "metabolism"}