{"version": "6.9", "hitCount": 3, "request": {"queryString": "\"MSMB\" AND \"lacrimal gland\"", "resultType": "core", "cursorMark": "*", "pageSize": 8, "sort": "", "synonym": false}, "resultList": {"result": [{"id": "37567940", "source": "MED", "pmid": "37567940", "pmcid": "PMC10421917", "fullTextIdList": {"fullTextId": ["PMC10421917"]}, "doi": "10.1038/s41598-023-40136-2", "title": "Ocular instillation of conditioned medium from mesenchymal stem cells is effective for dry eye syndrome by improving corneal barrier function.", "authorString": "Imaizumi T, Hayashi R, Kudo Y, Li X, Yamaguchi K, Shibata S, Okubo T, Ishii T, Honma Y, Nishida K.", "authorList": {"author": [{"fullName": "Imaizumi T", "lastName": "Imaizumi", "firstName": "Tsutomu", "initials": "T", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Stem Cells and Applied Medicine, Osaka University Graduate School of Medicine, Suita, Osaka, 565-0871, Japan."}, {"affiliation": "Basic Research Development Division, ROHTO Pharmaceutical, Ikuno-ku, Osaka, 544-8666, Japan."}]}}, {"fullName": "Hayashi R", "lastName": "Hayashi", "firstName": "Ryuhei", "initials": "R", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Stem Cells and Applied Medicine, Osaka University Graduate School of Medicine, Suita, Osaka, 565-0871, Japan. CONTACT_EMAIL."}, {"affiliation": "Department of Ophthalmology, Osaka University Graduate School of Medicine, Suita, Osaka, 565-0871, Japan. CONTACT_EMAIL."}, {"affiliation": "Institute for Open and Transdisciplinary Research Initiatives, Osaka University, Osaka, Osaka, 565-0871, Japan. CONTACT_EMAIL."}]}}, {"fullName": "Kudo Y", "lastName": "Kudo", "firstName": "Yuji", "initials": "Y", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Stem Cells and Applied Medicine, Osaka University Graduate School of Medicine, Suita, Osaka, 565-0871, Japan."}, {"affiliation": "Basic Research Development