ist": {"authorAffiliation": [{"affiliation": "Basic Research Development Division, ROHTO Pharmaceutical, Ikuno-ku, Osaka, 544-8666, Japan."}]}}, {"fullName": "Honma Y", "lastName": "Honma", "firstName": "Yoichi", "initials": "Y", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Basic Research Development Division, ROHTO Pharmaceutical, Ikuno-ku, Osaka, 544-8666, Japan."}]}}, {"fullName": "Nishida K", "lastName": "Nishida", "firstName": "Kohji", "initials": "K", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Ophthalmology, Osaka University Graduate School of Medicine, Suita, Osaka, 565-0871, Japan. CONTACT_EMAIL."}, {"affiliation": "Institute for Open and Transdisciplinary Research Initiatives, Osaka University, Osaka, Osaka, 565-0871, Japan. CONTACT_EMAIL."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0002-9081-1370"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"issue": "1", "volume": "13", "journalIssueId": 3609008, "dateOfPublication": "2023 Aug", "monthOfPublication": 8, "yearOfPublication": 2023, "journal": {"medlineAbbreviation": "Sci Rep", "title": "Scientific reports", "essn": "2045-2322", "issn": "2045-2322", "nlmid": "101563288", "isoabbreviation": "Sci Rep"}, "printPublicationDate": "2023-08-01"}, "pubYear": "2023", "pageInfo": "13100", "abstractText": "Dry eye syndrome (DES) is a chronic ocular disease that induces epithelial damage to the cornea by decreasing tear production and quality. Adequate treatment options have not been established for severe DES such as Sjogren's syndrome due to complicated pathological conditions. To solve this problem, we focused on the conditioned medium of human adipose-derived mesenchymal stem cells (hAdMSC-CM), which have multiple therapeutic properties. Here, we showed that hAdMSC-CM suppressed Benzalkonium Chloride (BAC)-induced cytotoxicity and inflammation in human corneal epithelial cells (hCECs). In addition, hAdMSC-CM increased the expression level and regulated the localisation of barrier function-related components, and improved the BAC-induced barrier dysfunction in hCECs. RNA-seq analysis and pharmacological inhibition experiments revealed that the effects of hAdMSC-CM were associated with the TGF\u03b2 and JAK-STAT signalling pathways. Moreover, in DES model rats with exorbital and intraorbital lacrimal gland excision, ocular instillation of hAdMSC-CM suppressed corneal epithelial damage by improving barrier dysfunction of the cornea. Thus, we demonstrated that hAdMSC-CM has multiple therapeutic properties associated with TGF\u03b2 and JAK-STAT signalling pathways, and ocular instillation of hAdMSC-CM may serve as an innovative therapeutic agent for DES by improving corneal barrier function.", "affiliation": "Department of Stem Cells and Applied Medicine, Osaka University Graduate School of Medicine, Suita, Osaka, 565-0871, Japan.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "research-article", "Journal Article"]}, "grantsList": {"grant": [{"agency": "The project for the Osaka City Innovation Support Grant", "orderIn": 0}, {"agency": "Grant-in-Aid for Scientific Research from Japan Society for the Promotion of Science (JSPS).", "grantId": "20H03842", "orderIn": 0}, {"agency": "Fusion Oriented Research for Disruptive Science and Technology from Japan Science and Technology Agency", "grantId": "JPMJFR210W", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Cornea", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "PA", "qualifierName": "pathology"}]}}, {"majorTopic_YN": "Y", "descriptorName": "Mesenchymal Stem Cells", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "ME", "qualifierName": "metabolism"}]}}, {"majorTopic_YN": "N", "descriptor