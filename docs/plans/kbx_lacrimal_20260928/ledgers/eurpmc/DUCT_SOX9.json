me": "Lebre", "firstName": "Sophie", "initials": "S", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "IMAG, Univ Montpellier, CNRS, Montpellier, France."}]}}, {"fullName": "Brehelin L", "lastName": "Brehelin", "firstName": "Laurent", "initials": "L", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "LIRMM, Univ Montpellier, CNRS, Montpellier, France."}]}}, {"fullName": "Parrinello H", "lastName": "Parrinello", "firstName": "Hughes", "initials": "H", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Montpellier GenomiX, MGX, BioCampus Montpellier, CNRS, INSERM, Univ. Montpellier, F-34094 Montpellier, France."}]}}, {"fullName": "Rohmer M", "lastName": "Rohmer", "firstName": "Marine", "initials": "M", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Montpellier GenomiX, MGX, BioCampus Montpellier, CNRS, INSERM, Univ. Montpellier, F-34094 Montpellier, France."}]}}, {"fullName": "Kaoma T", "lastName": "Kaoma", "firstName": "Tony", "initials": "T", "authorId": {"type": "ORCID", "value": "0000-0002-1269-4826"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Computational Biomedecine, Quantitative Biology Unit, Luxembourg Institute of Health, Strassen, Luxembourg."}]}}, {"fullName": "Vallar L", "lastName": "Vallar", "firstName": "Laurent", "initials": "L", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Proteome and Genome Research Unit, Department of Oncology, Luxembourg Institute of Health, Luxembourg, Luxembourg."}]}}, {"fullName": "Hughes JR", "lastName": "Hughes", "firstName": "Jim R", "initials": "JR", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Medical Research Council, Molecular Haematology Unit, Weatherall Institute of Molecular Medicine, Oxford University, Oxford, UK."}]}}, {"fullName": "Zibara K", "lastName": "Zibara", "firstName": "Kazem", "initials": "K", "authorId": {"type": "ORCID", "value": "0000-0002-9887-072X"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "PRASE, DSST, ER045, Lebanese University, Beirut, Lebanon."}, {"affiliation": "Biology Department, Faculty of Sciences-I, Lebanese University, Beirut, Lebanon."}]}}, {"fullName": "Lecellier CH", "lastName": "Lecellier", "firstName": "Charles-Henri", "initials": "CH", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "IGMM, Univ Montpellier, CNRS, Montpellier, France."}, {"affiliation": "LIRMM, Univ Montpellier, CNRS, Montpellier, France."}]}}, {"fullName": "Piechaczyk M", "lastName": "Piechaczyk", "firstName": "Marc", "initials": "M", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "IGMM, Univ Montpellier, CNRS, Montpellier, France."}]}}, {"fullName": "Jariel-Encontre I", "lastName": "Jariel-Encontre", "firstName": "Isabelle", "initials": "I", "authorId": {"type": "ORCID", "value": "0000-0002-5769-9233"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "IGMM, Univ Montpellier, CNRS, Montpellier, France."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-6757-0866"}, {"type": "ORCID", "value": "0000-0002-1269-4826"}, {"type": "ORCID", "value": "0000-0002-2799-4047"}, {"type": "ORCID", "value": "0000-0002-5034-0869"}, {"type": "ORCID", "value": "0000-0002-5769-9233"}, {"type": "ORCID", "value": "0000-0002-9887-072X"}]}, "dataLinksTagsList": {"dataLinkstag": ["supporting_data", "related_data"]}, "journalInfo": {"issue": "5", "volume": "49", "journalIssueId": 3134736, "dateOfPublication": "2021 Mar", "monthOfPublication": 3, "yearOfPublication": 2021, "journal": {"medlineAbbreviation": "Nucleic Acids Res", "title": "Nucleic acids research", "essn": "1362-4962", "issn": "0305-1048", "isoabbreviation": "Nucleic Acids Res", "nlmid": "0411011"}, "printPublicationDate": "2021-03-01"}, "pubYear": "2021", "pageInfo": "2488-2508", "abstractText": "The ubiquitous family of dimeric transcription factors AP-1 is made up of Fos and Jun family proteins. It has long been thought to operate principally at gene promoters and how it controls transcription is still ill-understood. The Fos family protein Fra-1 is overexpressed in triple negative breast cancers (TNBCs) where it contributes to tumor aggressiveness. To address its transcriptional actions in TNBCs, we combined transcriptomics, ChIP-seqs, machine learning and NG Capture-C. Additionally, we studied its Fos family kin Fra-2 also expressed in TNBCs, albeit much less. Consistently with their pleiotropic effects, Fra-1 and Fra-2 up- and downregulate individually, together or redundantly many genes associated with a wide range of biological processes. Target gene regulation is principally due to binding of Fra-1 and Fra-2 at regulatory elements located distantly from cognate promoters where Fra-1 modulates the recruitment of the transcriptional co-regulator p300/CBP and where differences in AP-1 variant motif recognition can underlie preferential Fra-1- or Fra-2 bindings. Our work also shows no major role for Fra-1 in chromatin architecture control at target gene loci, but suggests collaboration between Fra-1-bound and -unbound enhancers within chromatin hubs sometimes including promoters for other Fra-1-regulated genes. Our work impacts our view of AP-1.", "affiliation": "IGMM, Univ Montpellier, CNRS, Montpellier, France.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "research-article", "Journal Article"]}, "grantsList": {"grant": [{"agency": "Medical Research Council", "acronym": "MRC_", "grantId": "MR/T014067/1", "orderIn": 0}, {"agency": "Medical Research Council", "acronym": "MRC_", "grantId": "MC_UU_00016/14", "orderIn": 0}, {"agency": "France G\u00e9nomique National", "orderIn": 0}, {"agency": "Medical Research Council", "acronym": "MRC_", "grantId": "MC_UU_00016/1", "orderIn": 0}, {"agency": "Medical Research Cou