llName": "Small TN", "lastName": "Small", "firstName": "Trudy N", "initials": "TN"}, {"fullName": "O'Reilly R", "lastName": "O'Reilly", "firstName": "Richard", "initials": "R"}, {"fullName": "Manschreck C", "lastName": "Manschreck", "firstName": "Chris", "initials": "C"}, {"fullName": "Harlan Fleischut MM", "lastName": "Harlan Fleischut", "firstName": "Megan M", "initials": "MM"}, {"fullName": "Zhang L", "lastName": "Zhang", "firstName": "Liying", "initials": "L"}, {"fullName": "Sullivan J", "lastName": "Sullivan", "firstName": "John", "initials": "J"}, {"fullName": "Stratton K", "lastName": "Stratton", "firstName": "Kelly", "initials": "K"}, {"fullName": "Yeager M", "lastName": "Yeager", "firstName": "Meredith", "initials": "M"}, {"fullName": "Jacobs K", "lastName": "Jacobs", "firstName": "Kevin", "initials": "K"}, {"fullName": "Giri N", "lastName": "Giri", "firstName": "Neelam", "initials": "N"}, {"fullName": "Alter BP", "lastName": "Alter", "firstName": "Blanche P", "initials": "BP"}, {"fullName": "Boland J", "lastName": "Boland", "firstName": "Joseph", "initials": "J"}, {"fullName": "Burdett L", "lastName": "Burdett", "firstName": "Laurie", "initials": "L"}, {"fullName": "Offit K", "lastName": "Offit", "firstName": "Kenneth", "initials": "K"}, {"fullName": "Boulton SJ", "lastName": "Boulton", "firstName": "Simon J", "initials": "SJ", "authorId": {"type": "ORCID", "value": "0000-0001-6936-6834"}}, {"fullName": "Savage SA", "lastName": "Savage", "firstName": "Sharon A", "initials": "SA", "authorId": {"type": "ORCID", "value": "0000-0001-6006-0740"}}, {"fullName": "Petrini JH", "lastName": "Petrini", "firstName": "John H J", "initials": "JH", "authorId": {"type": "ORCID", "value": "0000-0001-5102-5679"}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-5102-5679"}, {"type": "ORCID", "value": "0000-0001-6006-0740"}, {"type": "ORCID", "value": "0000-0001-6936-6834"}, {"type": "ORCID", "value": "0000-0002-4471-1854"}, {"type": "ORCID", "value": "0000-0002-7413-4314"}, {"type": "ORCID", "value": "0000-0002-7933-151X"}, {"type": "ORCID", "value": "0000-0002-8650-2081"}]}, "dataLinksTagsList": {"dataLinkstag": ["supporting_data", "related_data"]}, "journalInfo": {"issue": "8", "volume": "9", "journalIssueId": 2065219, "dateOfPublication": "2013 Aug", "monthOfPublication": 8, "yearOfPublication": 2013, "journal": {"medlineAbbreviation": "PLoS Genet", "title": "PLoS genetics", "essn": "1553-7404", "issn": "1553-7390", "nlmid": "101239074", "isoabbreviation": "PLoS Genet"}, "printPublicationDate": "2013-08-01"}, "pubYear": "2013", "pageInfo": "e1003695", "abstractText": "Dyskeratosis congenita (DC) is a heterogeneous inherited bone marrow failure and cancer predisposition syndrome in which germline mutations in telomere biology genes account for approximately one-half of known families. Hoyeraal Hreidarsson syndrome (HH) is a clinically severe variant of DC in which patients also have cerebellar hypoplasia and may present with severe immunodeficiency and enteropathy. We discovered a germline autosomal recessive mutation in RTEL1, a helicase with critical telomeric functions, in two unrelated families of Ashkenazi Jewish (AJ) ancestry. The affected individuals in these families are homozygous for the same mutation, R1264H, which affects three isoforms of RTEL1. Each parent was a heterozygous carrier of one mutant allele. Patient-derived cell lines revealed evidence of telomere dysfunction, including significantly decreased telomere length, telomere length heterogeneity, and the presence of extra-chromosomal circular telomeric DNA. In addition, RTEL1 mutant cells exhibited enhanced sensitivity to the interstrand cross-linking agent mitomycin C. The molecular data and the patterns of inheritance are consistent with a hypomorphic mutation in RTEL1 as the underlying basis of the clinical and cellular phenotypes. This study further implicates RTEL1 in the etiology of DC/HH and immunodeficiency, and identifies the first known homozygous autosomal recessive disease-associated mutation in RTEL1.", "affiliation": "Clinical Genetics Branch, Division of Cancer Epidemiology and Genetics, National Cancer Institute, Rockville, Maryland, United States of America.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "research-article", "Journal Article", "Research Support, N.I.H., Extramural"]}, "grantsList": {"grant": [{"agency": "NIGMS NIH HHS", "acronym": "GM", "grantId": "R01 GM056888", "orderIn": 0}, {"agency": "NIGMS NIH HHS", "acronym": "GM", "grantId": "R37 GM059413", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CP", "grantId": "N02-CP-11019", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CP", "grantId": "N02-CP-91026", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "P30 CA008748", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CP", "grantId": "N02 CP011019", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R13 CA162528", "orderIn": 0}, {"agency": "Cancer Research UK", "acronym": "CRUK_", "grantId": "11581", "orderIn": 0}, {"agency": "NIGMS NIH HHS", "acronym": "GM", "grantId": "GM56888", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Telomere", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "GE", "qualifierName": "genetics"}]}}, {"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Microcephaly", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "ET", "qualifierName": "etiology"}, {"majorTopic_YN": "Y", "abbreviation": "GE", "qualifierName": "genetics"}, {"majorTopic_YN": "Y", "abbreviation": "PA", "qualifierName": "pathology"}]}}, {"majorTopic_YN": "N", "descriptorName": "Fetal Growth Retardation", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": 