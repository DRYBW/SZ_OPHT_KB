EMAIL."}, {"affiliation": "Department of Medicine, Brigham and Women's Hospital, Boston, MA, USA. CONTACT_EMAIL."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-5526-4669"}, {"type": "ORCID", "value": "0000-0001-7435-5603"}, {"type": "ORCID", "value": "0000-0001-9105-5856"}, {"type": "ORCID", "value": "0000-0001-9106-6141"}, {"type": "ORCID", "value": "0000-0002-0074-5163"}, {"type": "ORCID", "value": "0000-0002-0936-0753"}, {"type": "ORCID", "value": "0000-0002-1052-9456"}, {"type": "ORCID", "value": "0000-0002-1097-5229"}, {"type": "ORCID", "value": "0000-0002-3348-5054"}, {"type": "ORCID", "value": "0000-0002-7203-4299"}, {"type": "ORCID", "value": "0000-0002-8496-6181"}, {"type": "ORCID", "value": "0000-0002-9060-0207"}, {"type": "ORCID", "value": "0000-0003-1340-6272"}, {"type": "ORCID", "value": "0000-0003-2530-8610"}, {"type": "ORCID", "value": "0000-0003-2566-3145"}, {"type": "ORCID", "value": "0000-0003-3256-9640"}, {"type": "ORCID", "value": "0000-0003-3958-7489"}, {"type": "ORCID", "value": "0000-0003-4085-3115"}, {"type": "ORCID", "value": "0000-0003-4543-5553"}, {"type": "ORCID", "value": "0009-0001-0877-4030"}, {"type": "ORCID", "value": "0009-0005-0494-0467"}]}, "dataLinksTagsList": {"dataLinkstag": ["supporting_data"]}, "journalInfo": {"issue": "6", "volume": "43", "journalIssueId": 3961600, "dateOfPublication": "2025 Jun", "monthOfPublication": 6, "yearOfPublication": 2025, "journal": {"medlineAbbreviation": "Nat Biotechnol", "title": "Nature biotechnology", "essn": "1546-1696", "issn": "1087-0156", "nlmid": "9604648", "isoabbreviation": "Nat Biotechnol"}, "printPublicationDate": "2025-06-01"}, "pubYear": "2025", "pageInfo": "971-982", "abstractText": "T cell alloreactivity against minor histocompatibility antigens (mHAgs)-polymorphic peptides resulting from donor-recipient (D-R) disparity at sites of genetic polymorphisms-is at the core of the therapeutic effect of allogeneic hematopoietic cell transplantation (allo-HCT). Despite the crucial role of mHAgs in graft-versus-leukemia (GvL) and graft-versus-host disease (GvHD) reactions, it remains challenging to consistently link patient-specific mHAg repertoires to clinical outcomes. Here we devise an analytic framework to systematically identify mHAgs, including their detection on HLA class I ligandomes and functional verification of their immunogenicity. The method relies on the integration of polymorphism detection by whole-exome sequencing of germline DNA from D-R pairs with organ-specific transcriptional- and proteome-level expression. Application of this pipeline to 220 HLA-matched allo-HCT D-R pairs demonstrated that total and organ-specific mHAg load could independently predict the occurrence of acute GvHD and chronic pulmonary GvHD, respectively, and defined promising GvL targets, confirmed in a validation cohort of 58 D-R pairs, for the prevention or treatment of post-transplant disease recurrence.", "affiliation": "Department of Medical Oncology, Dana-Farber Cancer Institute, Boston, MA, USA.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["research-article", "Journal Article"]}, "grantsList": {"grant": [{"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R25 CA174650", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "U24 CA224331", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "P01 CA229092", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "P50 CA101942", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R01 CA155010", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R50 CA251956", "orderIn": 0}, {"agency": "Leukemia and Lymphoma Society (Leukemia & Lymphoma Society)", "grantId": "SCOR-22937-22", "orderIn": 0}, {"agency": "American Association for Cancer Research (American Association for Cancer Research, Inc.)", "grantId": "20-40-46-CIER", "orderIn":